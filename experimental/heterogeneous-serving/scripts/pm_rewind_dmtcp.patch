       JASSERT(Util::writeAll(fd, area.addr, area.mmapFileSize) ==
-              (ssize_t)area.mmapFileSize);
+              (ssize_t)area.mmapFileSize)
+        (JASSERT_ERRNO) (area.name) ((void*)area.addr)
